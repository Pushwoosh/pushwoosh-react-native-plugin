# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# The notification service extension links PushwooshFramework, which since 7.2 is split into
# PushwooshCore and PushwooshBridge. Without its own pod target the extension gets none of
# them and fails to build the module. It deliberately does not inherit from the app target:
# an extension has no business pulling in React Native.
target 'NotificationService' do
  pod 'PushwooshXCFramework'
end

target 'demoapp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Unit tests of the plugin's Objective-C++ module (Sources/src/ios/PushwooshPluginTests), run with
  # `make ios-test`. search_paths: the bundle resolves the plugin, React and the SDK through the
  # host app instead of linking a second copy of them; only the mocking library is its own.
  target 'PushwooshPluginTests' do
    inherit! :search_paths
    pod 'OCMock', '~> 3.9'
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
