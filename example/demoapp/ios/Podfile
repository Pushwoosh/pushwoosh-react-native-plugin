# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip
# Links the plugin's Swift package into the app and the extension; see the helper's header.
# Resolved with node as well, so a hoisted node_modules works too.
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "pushwoosh-react-native-plugin/scripts/pushwoosh-spm.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# The extension takes the SDK from the plugin's Swift package via pushwoosh_spm_post_install below;
# a trunk pod here would duplicate it, and inheriting from the app would drag in React Native.
target 'NotificationService' do
end

target 'demoapp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Plugin Objective-C++ unit tests (Sources/src/ios/PushwooshPluginTests), `make ios-test`: search_paths
  # resolves plugin and React through the host app; extra_targets below adds the SDK package for OCMock.
  target 'PushwooshPluginTests' do
    inherit! :search_paths
    pod 'OCMock', '~> 3.9'
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    pushwoosh_spm_post_install(installer, extra_targets: ['NotificationService', 'PushwooshPluginTests'])
  end
end
